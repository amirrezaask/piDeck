{
  "name": "pideck",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm build:binary && pnpm --filter @pideck/client make:dist && node scripts/verify-build.mjs",
    "build:binary": "turbo run build && node scripts/build-binary.mjs",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @pideck/web dev",
    "dev:client": "pnpm --filter @pideck/client dev",
    "dev:server": "pnpm --filter @pideck/server dev",
    "dev:supervisor": "pnpm --filter @pideck/server dev",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "typecheck": "turbo run typecheck",
    "lint:boundaries": "depcruise packages",
    "check": "pnpm typecheck && pnpm lint:boundaries",
    "test": "turbo run test",
    "test:coverage": "pnpm --filter @pideck/web test:coverage",
    "test:recovery": "pnpm vitest run --project node packages/database/tests/recovery.test.ts && pnpm vitest run --project node packages/supervisor/tests/recovery-process.test.ts",
    "test:soak": "node --expose-gc --import tsx --test tests/soak/event-stream-soak.test.mjs",
    "test:soak:ci": "node --expose-gc --import tsx --test tests/soak/event-stream-soak.test.mjs",
    "test:backup-restore": "node --test scripts/tests/backup-restore.test.mjs",
    "test:electron:packaged": "node scripts/test-packaged-electron.mjs",
    "test:server:packaged": "node scripts/test-packaged-server.mjs",
    "test:e2e": "playwright test",
    "lint": "turbo run lint && biome check tests scripts playwright.config.ts",
    "format": "biome format --write apps packages",
    "format:check": "biome format apps packages scripts tests",
    "verify": "pnpm check && pnpm lint && pnpm test && pnpm test:coverage && pnpm test:recovery && pnpm test:backup-restore && pnpm build:binary"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.13.3",
    "dependency-cruiser": "^18.2.0",
    "kysely": "^0.28.5",
    "tsx": "^4.20.3",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}

{
  "name": "pideck-monorepo",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "./scripts/prepare-effect.sh",
    "dev": "node scripts/dev.mjs",
    "dev:server": "vp run @yaade/server#dev",
    "dev:client": "vp run --filter @pideck/client-web dev",
    "dev:desktop": "vp run --filter @yaade/desktop dev",
    "dev:agents-desktop": "pnpm --filter @pideck/client dev",
    "build": "pnpm build:server && pnpm build:clients",
    "build:server": "vp run --filter @yaade/server build",
    "build:clients": "pnpm build:client && pnpm build:extension",
    "build:client": "vp run --filter @pideck/client-web build",
    "build:agents-desktop": "pnpm --filter @pideck/client build",
    "build:extension": "pnpm --filter @pideck/switcher build && node scripts/stage-extension.mjs",
    "build:agents-libs": "pnpm --filter @nextflow/contracts build && pnpm --filter @nextflow/database build && pnpm --filter @nextflow/observability build && pnpm --filter @nextflow/agent-runtime build && pnpm --filter @nextflow/test-agents build && pnpm --filter @pideck/terminal-multiplexer build",
    "build:desktop": "vp run --filter @yaade/desktop build",
    "build:release": "node scripts/build-release.mjs",
    "prepare:ghostty": "node scripts/prepare-ghostty-source.mjs prepare",
    "check:ghostty-source": "node scripts/prepare-ghostty-source.mjs check",
    "build:ghostty-native": "cargo build --release --manifest-path crates/ghostty-vt-sys/Cargo.toml",
    "test:ghostty-native": "cargo test --manifest-path crates/ghostty-vt-sys/Cargo.toml",
    "test:ghostty:parity": "node scripts/test-ghostty-parity.mjs",
    "test:terminal:unit": "vp test packages/ghostty-core packages/ghostty-react packages/yaade-host-client",
    "test:terminal:protocol": "node scripts/test-conformance.mjs && vp test packages/yaade-rpc/src/terminal-conformance.test.ts packages/yaade-rpc/src/terminal-ws.test.ts packages/yaade-rpc/src/terminal-ws.fuzz.test.ts",
    "test:terminal:integration": "cargo test --manifest-path packages/yaade-server/Cargo.toml terminal --lib",
    "test:fuzz:smoke": "node scripts/test-fuzz-smoke.mjs",
    "test:compatibility": "node scripts/test-compatibility.mjs",
    "test:server:sanitizers": "node scripts/test-server-sanitizers.mjs",
    "test:chaos": "node scripts/test-chaos.mjs",
    "test:soak": "node scripts/test-terminal-soak.mjs",
    "test:diagnostics": "pnpm test:bench:policy && node scripts/test-diagnostics.mjs && cargo test --manifest-path packages/yaade-server/Cargo.toml diagnostics --lib",
    "diagnostics:bundle": "node scripts/diagnostics-bundle.mjs",
    "release:quality": "node scripts/release-quality-report.mjs",
    "test:bench": "pnpm test:bench:policy && vp exec playwright test --project=bench",
    "test:bench:policy": "node --test tests/bench/slo-policy.test.mjs tests/bench/terminal-load-fixture.test.mjs",
    "test:server": "pnpm --filter @yaade/server test",
    "test:web": "vp test apps/web packages/ghostty-core packages/ghostty-react packages/yaade-app packages/yaade-host-client packages/yaade-panels packages/yaade-rpc packages/yaade-shared packages/yaade-ui packages/yaade-workspace",
    "test:agents": "pnpm build:agents-libs && pnpm --filter @pideck/agents-client test && pnpm --filter @pideck/supervisor test && pnpm --filter @pideck/client test && pnpm --filter @pideck/switcher test",
    "test:tasks": "pnpm --filter @pideck/tasks-client test",
    "test:desktop": "vp run --filter @yaade/desktop test",
    "test:web:e2e": "vp exec playwright test --project=web-e2e",
    "test:agents:e2e": "playwright test --config playwright.agents.config.ts",
    "test:tasks:e2e": "playwright test --config playwright.tasks.config.ts",
    "test": "pnpm test:server && pnpm test:web && pnpm test:agents && pnpm test:tasks",
    "typecheck": "pnpm build:agents-libs && vp run --filter './apps/*' --filter './packages/*' typecheck",
    "lint:boundaries": "depcruise packages",
    "lint:server": "pnpm --filter @yaade/server lint",
    "lint": "vp lint && pnpm lint:server",
    "format": "vp fmt && cargo fmt --manifest-path packages/yaade-server/Cargo.toml && cargo fmt --manifest-path apps/server/Cargo.toml",
    "format:check": "vp fmt --check && cargo fmt --manifest-path packages/yaade-server/Cargo.toml -- --check && cargo fmt --manifest-path apps/server/Cargo.toml -- --check",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build:clients"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@oxlint/plugins": "1.79.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "dependency-cruiser": "^18.2.0",
    "effect": "3.22.1",
    "kysely": "^0.28.5",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "tsx": "^4.23.13",
    "turbo": "^2.5.6",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowAny": [
        "vite"
      ],
      "allowedVersions": {
        "vite": "*"
      }
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tests/*",
      "tests/*/*"
    ],
    "catalog": {
      "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
      "vite-plus": "0.2.9"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pideck.dev/schemas/terminal-conformance-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "decoders"],
  "properties": {
    "version": { "const": 1 },
    "decoders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "path",
          "boundary",
          "maximumInputBytes",
          "currentVersion",
          "previousSupportedVersion",
          "corpus",
          "fuzzTarget",
          "compatibility"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
          "owner": { "enum": ["rust", "typescript", "native-wasm"] },
          "path": { "type": "string", "pattern": "^(apps|crates|packages)/" },
          "boundary": { "enum": ["wire", "persistence", "parser", "auth", "url-storage"] },
          "maximumInputBytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
          "currentVersion": { "type": ["integer", "string"] },
          "previousSupportedVersion": { "type": ["integer", "string", "null"] },
          "corpus": { "type": "string", "minLength": 1 },
          "fuzzTarget": { "type": "string", "minLength": 1 },
          "compatibility": {
            "enum": ["previous-current", "current-only", "reset-only", "compatibility-only"]
          }
        }
      }
    }
  }
}

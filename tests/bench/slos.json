{
  "version": 2,
  "profile": {
    "id": "local-release-chromium",
    "hardware": "Apple M4, 10 logical cores, 24 GiB RAM; no competing benchmark jobs",
    "browser": "pinned Chromium, 1440x900 CSS pixels, DPR 1, WebGL2, worker runtime",
    "network": "loopback; end-to-end proxy includes transport, echo stage reported separately",
    "refreshRates": [60, 120],
    "defaultRefreshHz": 60,
    "refreshToleranceFraction": 0.1,
    "build": "production SPA and release Rust host; record both artifact hashes"
  },
  "workloads": [
    {
      "id": "interactive-key-v2",
      "panes": 1,
      "bytesPerSecondPerPane": 0,
      "maxBurstBytes": 0,
      "minimumRateFraction": 0,
      "maximumDurationSeconds": 60
    },
    {
      "id": "ansi-paced-1pane-v1",
      "panes": 1,
      "bytesPerSecondPerPane": 524288,
      "maxBurstBytes": 16384,
      "minimumRateFraction": 0.8,
      "maximumDurationSeconds": 60
    },
    {
      "id": "ansi-paced-6pane-v1",
      "panes": 6,
      "bytesPerSecondPerPane": 524288,
      "maxBurstBytes": 16384,
      "minimumRateFraction": 0.8,
      "maximumDurationSeconds": 60
    }
  ],
  "overload": {
    "id": "ansi-unpaced-v1",
    "panes": [1, 6],
    "burstSeconds": 5,
    "recoveryCeilingMs": 5000,
    "status": "experimental",
    "policy": "No typing percentile gate above capacity. After the finite unpaced burst, require a usable terminal and the final marker on every pane. Keep queue bounds and byte-integrity checks; degradation must remain explicit."
  },
  "objectives": [
    {
      "metric": "terminal-key-next-raf-idle",
      "status": "enforced",
      "unit": "ms",
      "percentile": "p95",
      "ceiling": 42,
      "frameAllowance": 2,
      "processingAllowanceMs": 8,
      "corpus": "interactive-key-v2",
      "startFence": "keydown-captured",
      "endFence": "next-raf-after-matching-model-submission",
      "warmup": 5,
      "iterations": 100,
      "owner": "terminal-renderer"
    },
    {
      "metric": "terminal-key-next-raf-idle",
      "status": "enforced",
      "unit": "ms",
      "percentile": "p99",
      "ceiling": 66,
      "frameAllowance": 3,
      "processingAllowanceMs": 16,
      "corpus": "interactive-key-v2",
      "startFence": "keydown-captured",
      "endFence": "next-raf-after-matching-model-submission",
      "warmup": 5,
      "iterations": 100,
      "owner": "terminal-renderer"
    },
    {
      "metric": "terminal-key-next-raf-loaded-1pane",
      "status": "enforced",
      "unit": "ms",
      "percentile": "p95",
      "ceiling": 66,
      "frameAllowance": 3,
      "processingAllowanceMs": 16,
      "corpus": "ansi-paced-1pane-v1",
      "startFence": "keydown-captured",
      "endFence": "next-raf-after-matching-model-submission",
      "warmup": 5,
      "iterations": 100,
      "owner": "terminal-renderer"
    },
    {
      "metric": "terminal-key-next-raf-loaded-1pane",
      "status": "enforced",
      "unit": "ms",
      "percentile": "p99",
      "ceiling": 116,
      "frameAllowance": 5,
      "processingAllowanceMs": 32,
      "corpus": "ansi-paced-1pane-v1",
      "startFence": "keydown-captured",
      "endFence": "next-raf-after-matching-model-submission",
      "warmup": 5,
      "iterations": 100,
      "owner": "terminal-renderer"
    },
    {
      "metric": "terminal-key-next-raf-loaded-6pane",
      "status": "enforced",
      "unit": "ms",
      "percentile": "p95",
      "ceiling": 66,
      "frameAllowance": 3,
      "processingAllowanceMs": 16,
      "corpus": "ansi-paced-6pane-v1",
      "startFence": "keydown-captured",
      "endFence": "next-raf-after-matching-model-submission",
      "warmup": 5,
      "iterations": 100,
      "owner": "terminal-renderer"
    },
    {
      "metric": "terminal-key-next-raf-loaded-6pane",
      "status": "enforced",
      "unit": "ms",
      "percentile": "p99",
      "ceiling": 116,
      "frameAllowance": 5,
      "processingAllowanceMs": 32,
      "corpus": "ansi-paced-6pane-v1",
      "startFence": "keydown-captured",
      "endFence": "next-raf-after-matching-model-submission",
      "warmup": 5,
      "iterations": 100,
      "owner": "terminal-renderer"
    },
    {
      "metric": "session-switch",
      "status": "specified",
      "unit": "ms",
      "percentile": "p95",
      "ceiling": 100,
      "corpus": "warm-terminal",
      "startFence": "switch-requested",
      "endFence": "trustworthy-frame-presented",
      "warmup": 2,
      "iterations": 20,
      "owner": "terminal-surface"
    },
    {
      "metric": "terminal-reattach-screen",
      "status": "specified",
      "unit": "ms",
      "percentile": "p95",
      "ceiling": 100,
      "corpus": "million-line-history",
      "startFence": "attach-requested",
      "endFence": "snapshot-hash-painted",
      "warmup": 1,
      "iterations": 10,
      "owner": "terminal-transport"
    },
    {
      "metric": "terminal-reattach-input-safe",
      "status": "specified",
      "unit": "ms",
      "percentile": "p95",
      "ceiling": 500,
      "corpus": "million-line-history",
      "startFence": "attach-requested",
      "endFence": "ready-and-parser-current",
      "warmup": 1,
      "iterations": 10,
      "owner": "terminal-transport"
    },
    {
      "metric": "terminal-search-first-warm",
      "status": "specified",
      "unit": "ms",
      "percentile": "p95",
      "ceiling": 250,
      "corpus": "million-line-literal",
      "startFence": "query-accepted",
      "endFence": "first-result-indexed",
      "warmup": 1,
      "iterations": 10,
      "owner": "history-owner"
    },
    {
      "metric": "terminal-search-first-cold",
      "status": "specified",
      "unit": "ms",
      "percentile": "p95",
      "ceiling": 1000,
      "corpus": "million-line-literal",
      "startFence": "query-accepted",
      "endFence": "first-result-indexed",
      "warmup": 0,
      "iterations": 10,
      "owner": "history-owner"
    },
    {
      "metric": "terminal-history-reveal",
      "status": "specified",
      "unit": "ms",
      "percentile": "p95",
      "ceiling": 250,
      "corpus": "million-line-page",
      "startFence": "page-response-received",
      "endFence": "target-row-presented",
      "warmup": 1,
      "iterations": 10,
      "owner": "terminal-surface"
    },
    {
      "metric": "terminal-control-starvation",
      "status": "specified",
      "unit": "ms",
      "percentile": "max",
      "ceiling": 100,
      "corpus": "ansi-paced-6pane-v1",
      "startFence": "control-enqueued",
      "endFence": "control-applied",
      "warmup": 1,
      "iterations": 20,
      "owner": "terminal-runtime"
    },
    {
      "metric": "terminal-stream-throughput",
      "status": "enforced",
      "unit": "ms",
      "percentile": "median",
      "ceiling": 600,
      "corpus": "stream-throughput",
      "startFence": "fixture-started",
      "endFence": "matching-model-observed-after-raf",
      "warmup": 2,
      "iterations": 5,
      "owner": "terminal-renderer"
    },
    {
      "metric": "terminal-stream-throughput",
      "status": "enforced",
      "unit": "ms",
      "percentile": "p95",
      "ceiling": 2000,
      "corpus": "stream-throughput",
      "startFence": "fixture-started",
      "endFence": "matching-model-observed-after-raf",
      "warmup": 2,
      "iterations": 5,
      "owner": "terminal-renderer"
    },
    {
      "metric": "terminal-stream-throughput",
      "status": "enforced",
      "unit": "ms",
      "percentile": "p99",
      "ceiling": 2500,
      "corpus": "stream-throughput",
      "startFence": "fixture-started",
      "endFence": "matching-model-observed-after-raf",
      "warmup": 2,
      "iterations": 5,
      "owner": "terminal-renderer"
    },
    {
      "metric": "terminal-output-flood-throughput",
      "status": "enforced",
      "unit": "ms",
      "percentile": "median",
      "ceiling": 800,
      "corpus": "output-flood",
      "startFence": "fixture-started",
      "endFence": "matching-model-observed-after-raf",
      "warmup": 2,
      "iterations": 5,
      "owner": "terminal-renderer"
    },
    {
      "metric": "terminal-output-flood-throughput",
      "status": "enforced",
      "unit": "ms",
      "percentile": "p95",
      "ceiling": 1500,
      "corpus": "output-flood",
      "startFence": "fixture-started",
      "endFence": "matching-model-observed-after-raf",
      "warmup": 2,
      "iterations": 5,
      "owner": "terminal-renderer"
    },
    {
      "metric": "terminal-output-flood-throughput",
      "status": "enforced",
      "unit": "ms",
      "percentile": "p99",
      "ceiling": 2000,
      "corpus": "output-flood",
      "startFence": "fixture-started",
      "endFence": "matching-model-observed-after-raf",
      "warmup": 2,
      "iterations": 5,
      "owner": "terminal-renderer"
    }
  ],
  "zeroTolerance": [
    "missing-pty-bytes",
    "duplicate-pty-bytes",
    "terminal-hash-mismatch",
    "queue-bound-violation",
    "history-bound-violation",
    "authorization-violation"
  ]
}

{
  "name": "@pideck/terminal-multiplexer",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./client": "./client.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postinstall": "node scripts/fix-node-pty-perms.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@yaade/ghostty-react": "workspace:*",
    "motion": "^13.1.1",
    "node-pty": "^1.1.0",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "react": "^19.2.8"
  }
}

{
  "name": "@yaade/server",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "cargo run --manifest-path Cargo.toml -- serve",
    "start": "cargo run --release --manifest-path Cargo.toml -- serve",
    "build": "cargo build --release --locked --manifest-path Cargo.toml",
    "typecheck": "cargo check --manifest-path Cargo.toml",
    "test": "cargo test --manifest-path Cargo.toml",
    "lint": "cargo fmt --manifest-path Cargo.toml -- --check && cargo clippy --manifest-path Cargo.toml --all-targets -- -D warnings"
  }
}

{
  "name": "@pideck/server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "NEXTFLOW_SUPERVISOR_TOKEN=${NEXTFLOW_SUPERVISOR_TOKEN:-pideck-local-dev-token} tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "biome check src"
  },
  "dependencies": {
    "@pideck/supervisor": "workspace:*"
  }
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["chrome", "vitest/globals", "@testing-library/jest-dom"],
    "paths": { "/src/*": ["./src/*"] },
    "declaration": false
  },
  "include": [
    ".wxt/wxt.d.ts",
    "entrypoints",
    "src",
    "tests",
    "wxt.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}

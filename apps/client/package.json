{
  "name": "@pideck/client",
  "productName": "piDeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "pnpm --filter @pideck/web build && tsc -p tsconfig.build.json && node scripts/copy-renderer.mjs",
    "dev": "pnpm build && electron .",
    "start": "electron .",
    "package": "pnpm build && electron-forge package",
    "make": "pnpm build && electron-forge make",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "biome check src forge.config.cjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/core": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "electron": "^43.4.0"
  }
}
